local function setRunning(state)
	if state and not Bot.Target then
		setStatus("сначала выберите игрока")
		TweenService:Create(toggle, TweenInfo.new(0.1), { Position = UDim2.new(0, 18, 1, -78) }):Play()
		task.delay(0.1, function()
			TweenService:Create(toggle, TweenInfo.new(0.1), { Position = UDim2.new(0, 12, 1, -78) }):Play()
		end)
		return
	end

	Bot.Running = state
	Bot.Token += 1
	Bot.Climbing = false
	Bot.Steps = 0
	Sword = nil
	resetMemory()

	if state then
		toggle.Text = "■  Бежать до цели: ВКЛ"
		TweenService:Create(toggle, TweenInfo.new(0.25), { BackgroundColor3 = COLORS.on }):Play()
		task.spawn(runBot, Bot.Token)
		task.spawn(attackLoop, Bot.Token)
		task.spawn(espLoop, Bot.Token)
	else
		toggle.Text = "▶  Бежать до цели: ВЫКЛ"
		TweenService:Create(toggle, TweenInfo.new(0.25), { BackgroundColor3 = COLORS.off }):Play()
		setStatus("остановлено")
		clearESP()
	end
end

