local Failed, Dead = {}, {}

local function keyOf(pos, s)
	return math.floor(pos.X / s) .. ":" .. math.floor(pos.Z / s) .. ":" .. math.floor(pos.Y / s)
end

local function markFail(pos)
	local k = keyOf(pos, 4)
	local f = Failed[k]
	if f and os.clock() - f.t < 25 then
		f.n += 1
		f.t = os.clock()
	else
		Failed[k] = { n = 1, t = os.clock() }
	end
end

local function isFailed(pos)
	local f = Failed[keyOf(pos, 4)]
	return f ~= nil and f.n >= 2 and os.clock() - f.t < 25
end

local function markDead(pos)
	Dead[keyOf(pos, 8)] = os.clock()
end

local function isDead(pos)
	local t = Dead[keyOf(pos, 8)]
	return t ~= nil and os.clock() - t < 40
end

