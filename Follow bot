local function espLoop(token)
	while active(token) do
		local plr = Bot.Target
		if plr and plr.Character and plr.Character ~= ESP.Char then
			buildESP(plr, plr.Character)
		end

		local _, hum, hrp = getParts(plr)
		local _, _, myHrp = getParts(LocalPlayer)
		if ESP.Info and hum and hrp and myHrp then
			local dist = (hrp.Position - myHrp.Position).Magnitude
			ESP.Info.Text = string.format("%d studs   ❤ %d", dist, hum.Health)
		end
		task.wait(0.1)
	end
	clearESP()
end

